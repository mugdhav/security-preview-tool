<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="security-preview {{ tool_version }}">
<title>security-preview report — {{ target }}</title>
<style>
  :root{
    --ground:#faf9f6; --card:#ffffff; --ink:#131314; --subdued:#6b7280;
    --border:#e5e7eb; --border-strong:#d5d8dd; --accent:#d97757; --accent-hover:#cc6944;
    --sca:#6941c6; --ok:#067647; --ok-tint:#ecfdf3; --warn:#b54708; --warn-tint:#fffaeb;
    --crit:#912018; --high:#d92d20; --med:#b45309; --low:#175cd3; --info:#667085;
    --crit-tint:#fef3f2; --high-tint:#fff4ed;
    --mono:ui-monospace,"Cascadia Code","SF Mono",Menlo,Consolas,monospace;
    --sans:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  }
  @media (prefers-color-scheme: dark){
    :root{
      --ground:#131314; --card:#1c1c1e; --ink:#f2f2f0; --subdued:#9aa0a6;
      --border:#2e2e30; --border-strong:#3a3a3c;
    }
  }
  *{box-sizing:border-box}
  html{background:var(--ground)}
  body{margin:0;font-family:var(--sans);background:var(--ground);color:var(--ink);
    font-size:14px;line-height:1.6;padding:40px 0}
  a{color:var(--accent);text-decoration:none}
  a:hover{color:var(--accent-hover);text-decoration:underline}
  .skip{position:absolute;left:-9999px}
  .skip:focus{left:16px;top:16px;background:var(--card);border:1px solid var(--border);
    padding:8px 12px;border-radius:6px;z-index:10}
  .page{max-width:820px;width:calc(100% - 32px);margin:0 auto;background:var(--card);
    border:1px solid var(--border);border-radius:6px;padding:44px 52px}
  .mono{font-family:var(--mono)}
  h1{font-size:26px;font-weight:650;margin:0;letter-spacing:-.01em}
  .head{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
  .ver{font-family:var(--mono);font-size:12px;color:var(--subdued)}
  .kv{font-size:12px;color:var(--subdued);margin-top:8px;font-family:var(--mono)}
  h2{font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;
    color:var(--subdued);margin:34px 0 12px;padding-bottom:6px;border-bottom:1px solid var(--border)}
  .toc{font-size:13px;display:flex;flex-direction:column;gap:5px;list-style:none;padding:0;margin:0}
  .sumtable{border-collapse:collapse;width:100%;font-size:13px}
  .sumtable td{padding:7px 10px;border-bottom:1px solid var(--border)}
  .sumtable td:last-child{text-align:right;font-variant-numeric:tabular-nums;font-weight:600}
  .pill{display:inline-flex;align-items:center;gap:6px;padding:2px 9px;border-radius:999px;
    font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#fff}
  .banner{display:flex;gap:10px;align-items:flex-start;border-radius:8px;padding:12px 15px;
    font-size:13px;border:1px solid;margin:14px 0;background:var(--warn-tint);border-color:#fde3b3}
  .banner .mark{color:var(--warn);font-weight:700;flex:none}
  .ok-banner{background:var(--ok-tint);border-color:#c9ecd8}
  .ok-banner .mark{color:var(--ok)}
  details.finding{border:1px solid var(--border);border-radius:8px;margin-bottom:10px;
    overflow:hidden;border-left:3px solid var(--sev)}
  details.finding>summary{display:flex;align-items:center;gap:11px;padding:12px 15px;
    cursor:pointer;list-style:none}
  details.finding>summary::-webkit-details-marker{display:none}
  .caret{color:var(--subdued);flex:none;transition:none}
  details[open] .caret{transform:rotate(90deg)}
  .badge{display:inline-flex;align-items:center;gap:5px;padding:3px 8px;border-radius:999px;
    font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#fff;flex:none}
  .ftitle{font-weight:650;font-size:14px}
  .tag{display:inline-flex;padding:2px 7px;border-radius:5px;font-size:10px;font-weight:600;
    background:#f2f4f7;color:#475467;border:1px solid var(--border)}
  .loc{font-family:var(--mono);font-size:12px;color:var(--subdued)}
  .grow{flex:1}
  .fbody{padding:0 15px 16px;border-top:1px solid var(--border)}
  .snip{font-family:var(--mono);font-size:12px;line-height:1.7;background:#1c1c1e;color:#d4d4d6;
    border-radius:6px;padding:11px 0;margin:12px 0;overflow-x:auto}
  .snip .ln{display:flex;gap:12px;padding:0 14px;white-space:pre}
  .snip .num{color:#6b6b70;width:30px;text-align:right;flex:none;user-select:none}
  .snip .hit{background:rgba(217,45,32,.18);box-shadow:inset 3px 0 0 var(--high)}
  .sub{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;
    color:var(--subdued);margin:14px 0 6px}
  .rem{border:1px solid var(--border);border-radius:6px;overflow:hidden;margin-bottom:7px}
  .rem .h{font-size:10px;font-weight:700;text-transform:uppercase;padding:5px 10px}
  .rem .h.bad{background:var(--crit-tint);color:var(--crit)}
  .rem .h.good{background:var(--ok-tint);color:var(--ok)}
  .rem .c{font-family:var(--mono);font-size:12px;padding:9px 10px;white-space:pre-wrap;
    word-break:break-word}
  .cve{display:inline-flex;padding:2px 8px;border-radius:999px;font-size:11px;font-weight:600;
    font-family:var(--mono);background:var(--card);border:1px solid var(--border-strong);
    color:#344054;margin-right:6px}
  table.deps{border-collapse:collapse;width:100%;font-size:12.5px}
  table.deps th{text-align:left;font-size:10px;text-transform:uppercase;letter-spacing:.05em;
    color:var(--subdued);padding:8px 10px;border-bottom:1px solid var(--border)}
  table.deps td{padding:9px 10px;border-bottom:1px solid var(--border);vertical-align:top}
  .errlist{font-size:13px;padding-left:18px;margin:0}
  .errlist li{margin-bottom:5px}
  .footer{margin-top:30px;padding-top:16px;border-top:1px solid var(--border);
    font-size:12px;color:var(--subdued)}
  .cmd{font-family:var(--mono);font-size:12px;background:#f6f5f2;border:1px solid var(--border);
    border-radius:6px;padding:9px 12px;margin-top:8px;color:#3a3a3c}
  @media (prefers-color-scheme: dark){ .cmd{background:#232325;color:#c9c9cc} .tag,.cve{color:#c9c9cc} }
  @media print{
    body{background:#fff;color:#111;padding:0;font-size:12px}
    .page{max-width:none;width:auto;border:none;border-radius:0;padding:24px 32px;background:#fff}
    a{color:#111;text-decoration:underline}
    a::after{content:" (" attr(href) ")";font-family:var(--mono);font-size:10px;color:#333}
    .toc a::after{content:""}
    .skip,.caret{display:none}
    h2{border-color:#000;color:#000}
    details.finding{border:1px solid #000;border-left:1px solid #000;break-inside:avoid}
    details.finding>summary{list-style:none}
    details.finding:not([open]) .fbody{display:block}
    .fbody{display:block !important}
    .snip{background:#fafafa;color:#111;border:1px solid #bdbdbd}
    .snip .num{color:#999}
    .snip .hit{background:#ececec;font-weight:700;box-shadow:inset 3px 0 0 #000}
    .badge{color:#000 !important;background:#fff !important;border:1.5px solid #000}
    .pill{color:#000 !important;background:#fff !important;border:1.5px solid #000}
    .badge.crit,.pill.crit{background:#000 !important;color:#fff !important}
    .badge.high,.pill.high{border-style:double;border-width:3px}
    .badge.med,.pill.med{background:#e6e6e6 !important}
    .badge.info,.pill.info{border-style:dotted}
    .rem .h.bad::before{content:"\2717  "}
    .rem .h.good::before{content:"\2713  "}
    .rem .h{background:#fff !important;color:#000 !important;border-bottom:1px solid #bdbdbd}
    .cmd{background:#f4f4f4;color:#111;border-color:#bdbdbd}
  }
</style>
</head>
<body>
<a class="skip" href="#summary">Skip to report</a>
<div class="page">
  <header>
    <div class="head">
      <h1>security-preview report</h1>
      <span class="ver">v{{ tool_version }}</span>
    </div>
    <div class="kv">target &nbsp; {{ target }}<br>scanned &nbsp; {{ scanned_line }}</div>
  </header>

  <nav aria-label="Contents">
    <h2>Contents</h2>
    <ul class="toc">
      <li><a href="#summary">1 &nbsp; Summary</a></li>
      <li><a href="#code">2 &nbsp; Code findings ({{ total_findings }})</a></li>
      <li><a href="#deps">3 &nbsp; Vulnerable dependencies ({{ dep_count }})</a></li>
      <li><a href="#errors">4 &nbsp; Skipped / errors ({{ error_count }})</a></li>
    </ul>
  </nav>

  <main>
  <section aria-labelledby="summary">
  <h2 id="summary">1 &nbsp; Summary</h2>
  <table class="sumtable">
    {% for row in sev_rows %}
    <tr>
      <td><span class="pill {{ row.level|lower }}" style="background:{{ row.hex }}">{{ row.label }}</span></td>
      <td>{{ row.count }}</td>
    </tr>
    {% endfor %}
    <tr>
      <td><span class="pill" style="background:var(--sca)">Vulnerable dependencies</span></td>
      <td>{{ dep_count }}</td>
    </tr>
    <tr>
      <td style="color:var(--subdued)">Files scanned / dependencies checked</td>
      <td>{{ files_scanned }} / {{ deps_scanned }}</td>
    </tr>
  </table>
  {% if partial %}
  <div class="banner" role="status">
    <span class="mark" aria-hidden="true">&#9650;</span>
    <div><strong>PARTIAL &mdash; {{ error_count }} issue(s) recorded during the scan.</strong>
      All code findings and dependency matches below are complete; some illustrative data
      may be missing. Details in section&nbsp;4.</div>
  </div>
  {% endif %}
  {% if total_findings == 0 and dep_count == 0 and not partial %}
  <div class="banner ok-banner" role="status">
    <span class="mark" aria-hidden="true">&#10003;</span>
    <div><strong>No findings.</strong> No code findings or vulnerable dependencies were
      detected. Consider re-scanning at a lower confidence threshold.</div>
  </div>
  {% endif %}
  </section>

  <section aria-labelledby="code">
  <h2 id="code">2 &nbsp; Code findings</h2>
  {% if not findings %}
  <p class="loc">No code findings.</p>
  {% endif %}
  {% for f in findings %}
  <details class="finding {{ f.sev_level|lower }}" style="--sev:{{ f.sev_hex }}"{% if f.open %} open{% endif %}>
    <summary>
      <svg class="caret" width="15" height="15" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 4l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span class="badge {{ f.sev_level|lower }}" style="background:{{ f.sev_hex }}">{{ f.sev_label }}</span>
      <span class="ftitle">{{ f.name }}</span>
      {% if f.cwe_url %}<a class="mono" style="font-size:11px" href="{{ f.cwe_url }}">{{ f.cwe_id }}</a>{% elif f.cwe_id %}<span class="mono" style="font-size:11px">{{ f.cwe_id }}</span>{% endif %}
      <span class="tag">{{ f.category }}</span>
      <span class="grow"></span>
      <span class="loc">{{ f.file_path }}:{{ f.line }} &middot; {{ f.confidence }} confidence</span>
    </summary>
    <div class="fbody">
      <div class="snip" aria-label="code snippet">
        {% for l in f.snippet %}
        <div class="ln{% if l.hit %} hit{% endif %}"><span class="num">{% if l.num is not none %}{{ l.num }}{% endif %}</span><span>{{ l.text }}</span></div>
        {% endfor %}
      </div>
      <div class="sub">What&#39;s wrong</div>
      <p style="margin:0">{{ f.description }}</p>
      <div class="sub">Remediation</div>
      <div class="rem"><div class="h bad">Vulnerable</div><div class="c">{{ f.rem_vuln }}</div></div>
      <div class="rem"><div class="h good">Secure</div><div class="c">{{ f.rem_secure }}</div></div>
      {% if f.cves %}
      <div class="sub">Illustrative CVEs</div>
      <div>{% for c in f.cves %}<a class="cve" href="{{ c.url }}">{{ c.id }}</a>{% endfor %}</div>
      {% endif %}
    </div>
  </details>
  {% endfor %}
  </section>

  <section aria-labelledby="deps">
  <h2 id="deps">3 &nbsp; Vulnerable dependencies</h2>
  {% if not deps %}
  <p class="loc">No vulnerable dependencies.</p>
  {% else %}
  <table class="deps">
    <thead><tr><th>Package</th><th>Advisory</th><th>Severity</th><th>Fixed in</th><th>Source</th></tr></thead>
    <tbody>
      {% for d in deps %}
      <tr>
        <td class="mono">{{ d.package }} {{ d.version }}</td>
        <td>{% for a in d.advisories %}<a href="{{ a.url }}">{{ a.id }}</a>{% if not loop.last %} &middot; {% endif %}{% endfor %}</td>
        <td><span class="pill {{ d.severity|lower }}" style="background:{{ d.sev_hex }}">{{ d.sev_label }}</span></td>
        <td class="mono">{{ d.fixed_version if d.fixed_version else "—" }}</td>
        <td class="mono">{{ d.source_manifest }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
  </section>

  <section aria-labelledby="errors">
  <h2 id="errors">4 &nbsp; Skipped / errors</h2>
  {% if not errors %}
  <p class="loc">Nothing was skipped; all stages completed.</p>
  {% else %}
  <ul class="errlist">
    {% for e in errors %}
    <li><strong>{{ e.stage }}</strong> &mdash; <span class="mono">{{ e.target }}</span>: {{ e.message }}</li>
    {% endfor %}
  </ul>
  {% endif %}
  </section>
  </main>

  <footer class="footer">
    Generated by security-preview v{{ tool_version }} &mdash; a deterministic, non-LLM static
    scan. Findings are pattern- and dependency-based; treat them as leads, not proof. Re-run:
    <div class="cmd">{{ rerun_cmd }}</div>
  </footer>
</div>
</body>
</html>
